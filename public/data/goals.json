      "syllabus": [
        {
          "id": "au-field",
          "t": "Choose your main field: mechatronics or software (you can apply to both later)",
          "min": 30,
          "tiny": "Write the two options and one reason for each",
          "due": "2026-11-30",
          "links": [
            {
              "t": "Make it in Germany",
              "u": "https://www.make-it-in-germany.com",
              "kind": "docs",
              "free": true
            }
          ]
        },
        {
          "id": "au-passport",
          "t": "Check your passport is valid for at least 6 months beyond your planned arrival in Germany; apply or renew now if needed",
          "min": 30,
          "tiny": "Open your passport and read the expiry date",
          "due": "2026-11-30",
          "links": [
            {
              "t": "Passport Seva",
              "u": "https://www.passportindia.gov.in",
              "kind": "docs",
              "free": true
            }
          ]
        },
        {
          "id": "au-docs-copies",
          "t": "Collect copies of your school certificates (10th, 12th, diploma or ITI), ID and birth certificate",
          "min": 45,
          "tiny": "List the certificates you have",
          "due": "2026-12-31"
        },
        {
          "id": "au-docs-duplicates",
          "t": "Ask your school or college what it takes to get duplicates or attested copies",
          "min": 30,
          "tiny": "Write down who to call or email",
          "needs": [
            "au-docs-copies"
          ],
          "due": "2026-12-31"
        },
        {
          "id": "au-a1-mock",
          "t": "A1 checkpoint: take a free Goethe Start Deutsch 1 sample test (aim for 60% or more; if lower, revise in the first week of January)",
          "min": 60,
          "tiny": "Open the Start Deutsch 1 sample test",
          "needs": [
            "ger3",
            "ger4",
            "ger5"
          ],
          "due": "2026-12-31",
          "links": [
            {
              "t": "Goethe: find the free sample tests",
              "u": "https://www.goethe.de",
              "kind": "practice",
              "free": true
            }
          ]
        },
        {
          "id": "au-apostille",
          "t": "Start the apostille process for your educational certificates (MEA attestation in India; allow 2 to 6 weeks)",
          "min": 45,
          "tiny": "Open the MEA attestation page and note the steps",
          "needs": [
            "au-docs-duplicates"
          ],
          "due": "2027-01-31",
          "links": [
            {
              "t": "Ministry of External Affairs",
              "u": "https://www.mea.gov.in",
              "kind": "docs",
              "free": true
            }
          ]
        },
        {
          "id": "au-pcc",
          "t": "Start the police clearance certificate (PCC) application through the passport authority (allow 4 to 8 weeks)",
          "min": 45,
          "tiny": "Find the PCC form on the passport site",
          "needs": [
            "au-passport"
          ],
          "due": "2027-01-31",
          "links": [
            {
              "t": "Passport Seva",
              "u": "https://www.passportindia.gov.in",
              "kind": "docs",
              "free": true
            }
          ]
        },
        {
          "id": "au-a2-mock",
          "t": "A2 checkpoint: take an A2 sample test (if A2 is not mostly done by the end of February, use the fallback in the ladder note)",
          "min": 60,
          "tiny": "Open an A2 sample test",
          "needs": [
            "ger7",
            "ger8",
            "ger9",
            "ger10"
          ],
          "due": "2027-02-28",
          "links": [
            {
              "t": "Goethe: find the free sample tests",
              "u": "https://www.goethe.de",
              "kind": "practice",
              "free": true
            }
          ]
        },
        {
          "id": "au-portfolio-sw",
          "t": "Software track: start a small GitHub portfolio with 2 to 3 projects and short English READMEs",
          "min": 60,
          "tiny": "Create the GitHub repository for project 1",
          "due": "2027-02-28",
          "links": [
            {
              "t": "GitHub",
              "u": "https://github.com",
              "kind": "docs",
              "free": true
            }
          ]
        },
        {
          "id": "au-portfolio-mech",
          "t": "Mechatronics track: list your lab work, diploma projects, ITI trades and hobby builds (Arduino, Raspberry Pi)",
          "min": 45,
          "tiny": "Write down three things you have built",
          "due": "2027-02-28"
        },
        {
          "id": "au-vocab-tech",
          "t": "Learn technical German vocabulary for your field. Mechatronics: Schaltplan, Steuerung, Sensor, Antrieb, Maschine, Werkzeug, Messger\u00e4t. Software: Programmiersprache, Datenbank, Netzwerk, Fehler, Anwendung",
          "min": 30,
          "tiny": "Write 5 of these words with their article",
          "needs": [
            "ger10"
          ],
          "due": "2027-03-31"
        },
        {
          "id": "au-b1-register",
          "t": "Check the Goethe India website for B1 dates in May and June 2027 and register as soon as they open (modules can be booked together or separately; bring the original passport on exam day)",
          "min": 30,
          "tiny": "Open the Goethe India exam page",
          "needs": [
            "au-a2-mock"
          ],
          "due": "2027-04-30",
          "links": [
            {
              "t": "Goethe-Institut",
              "u": "https://www.goethe.de",
              "kind": "docs",
              "free": true
            }
          ]
        },
        {
          "id": "au-b1-mocks",
          "t": "Take full B1 mock tests every week, timed (aim for 60% or more; if lower, move the exam by one cycle)",
          "min": 90,
          "tiny": "Open the next B1 sample test and set a timer",
          "needs": [
            "ger14",
            "ger16"
          ],
          "due": "2027-04-30",
          "links": [
            {
              "t": "Goethe: find the free sample tests",
              "u": "https://www.goethe.de",
              "kind": "practice",
              "free": true
            }
          ]
        },
        {
          "id": "au-b1-writing",
          "t": "B1 writing practice: a formal email, an informal email and a forum post, corrected by a teacher or language partner",
          "min": 45,
          "tiny": "Write the first two lines of a formal email",
          "needs": [
            "ger14"
          ],
          "due": "2027-04-30"
        },
        {
          "id": "au-b1-speaking",
          "t": "B1 speaking practice: a 2 to 3 minute presentation and a short discussion",
          "min": 30,
          "tiny": "Record a one-minute talk on a familiar topic",
          "needs": [
            "ger16"
          ],
          "due": "2027-04-30"
        },
        {
          "id": "au-employer-questions",
          "t": "Prepare questions to ask employers: training plan, vocational school location, accommodation help, support with visa paperwork",
          "min": 30,
          "tiny": "Write three questions",
          "due": "2027-05-31"
        },
        {
          "id": "au-b1-results",
          "t": "Receive your B1 results (about 4 to 6 weeks after the exam); if a module fails, rebook that module only",
          "min": 15,
          "tiny": "Note the date results are expected",
          "needs": [
            "ger18"
          ],
          "due": "2027-06-30"
        },
        {
          "id": "au-arrival",
          "t": "Prepare for arrival: Anmeldung (address registration) and the residence permit appointment",
          "min": 30,
          "tiny": "Search how Anmeldung works in your city",
          "needs": [
            "au-b1-results"
          ],
          "due": "2027-08-31"
        },
        {
          "id": "au-selfcheck",
          "t": "Monthly self-check: studied 5+ days a week? checklist done? mock test 60%+? documents moving? Adjust the plan",
          "min": 15,
          "tiny": "Answer the first question for last month"
        }
      ],
